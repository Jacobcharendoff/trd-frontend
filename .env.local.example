# ─── Shopify Storefront API ───
# Read-only token for fetching products, creating carts, and checkout
# Create at: Shopify Admin > Settings > Apps > Develop apps > Create app
#   → Configure Storefront API scopes (products, checkout) > Install
# This is a PUBLIC token (safe for client-side) — rate-limited per token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_token_here

# ─── Site URL ───
# Used in metadata, Open Graph tags, and structured data
NEXT_PUBLIC_SITE_URL=https://therigdr.com

# ─── Google Analytics ───
# GA4 measurement ID for tracking
# Find at: Google Analytics > Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── HubSpot CRM ───
# Private App token for creating contacts, notes, and tickets from the contact form
# Create at: HubSpot > Settings > Integrations > Private Apps > Create
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.deals.read, crm.objects.deals.write, tickets
# If omitted, the contact form still works but data won't flow to HubSpot
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here
