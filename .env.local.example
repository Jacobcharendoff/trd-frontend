# Shopify Storefront API
# Create at: Shopify Admin > Settings > Apps > Develop apps > Create app > Configure Storefront API scopes > Install
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_token_here

# Site URL (for metadata)
NEXT_PUBLIC_SITE_URL=https://www.therigdr.com

# HubSpot Portal ID (tracking script — loads hs-scripts.com for visitor tracking)
# Find at: HubSpot > Settings > Account Setup > Account Defaults > Portal ID
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=245067165

# HubSpot Private App Token (CRM contact creation for Signal Flow leads)
# Create at: HubSpot > Settings > Integrations > Private Apps > Create
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Resend (email delivery for Signal Flow nurture sequence)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Jacob <jacob@therigdr.com>
RESEND_VINCE_FROM_EMAIL=Vince <vince@therigdr.com>
